# Live mode remains disabled unless the exact deployment has been authorized.
PROVENANCE_STUDIO_ENABLE_LIVE=false

# Backblaze B2. Use a bucket-scoped, least-privilege application key.
B2_BUCKET=
B2_REGION=
B2_KEY_ID=
B2_APP_KEY=
B2_PUBLIC_URL_BASE=

# Generative-media provider. NVIDIA is the no-card free path documented by
# Backblaze's official hackathon starter project; GMI remains supported.
GEN_MEDIA_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
GMI_API_KEY=
GMI_IMAGE_MODEL=seedream-5.0-lite

# Share only with judges through the submission's test instructions.
DEMO_ACCESS_TOKEN=
MAX_GENERATIONS_PER_PROCESS=25
